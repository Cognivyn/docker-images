# Standard Cognivyn Application Dockerfile Template
# Usage: Copy this file into your application repository as Dockerfile

ARG BASE_IMAGE=ghcr.io/cognivyn/base-node:latest
FROM ${BASE_IMAGE}

LABEL maintainer="Cognivyn DevOps <devops@cognivyn.com>"

WORKDIR /app

# Install dependencies
COPY --chown=cognivyn:cognivyn package*.json ./
RUN npm ci --only=production

# Copy application source
COPY --chown=cognivyn:cognivyn . .

# Expose service port
EXPOSE 3000

# Health check specification
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["npm", "start"]
